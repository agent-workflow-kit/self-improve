{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "self-improve/slot/request.json",
  "title": "staged request",
  "description": "inputs/<run>/request.json staged for the drafting session: ids, hashes, counts and enums only.",
  "type": "object",
  "properties": {
    "proposal_id": {
      "$ref": "../defs.json#/$defs/proposal_id"
    },
    "run_token": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]{16,128}(?![\\s\\S])"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "run": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "description": "The run number; the inputs are in inputs/<run>/."
    },
    "target_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^target(\\.[A-Za-z0-9]{1,16})?(?![\\s\\S])",
      "description": "The staged file name; no path."
    },
    "target_sha256": {
      "$ref": "../defs.json#/$defs/sha256"
    },
    "target_class": {
      "$ref": "../defs.json#/$defs/target_class"
    },
    "risk": {
      "$ref": "../defs.json#/$defs/risk"
    },
    "limits": {
      "type": "object",
      "properties": {
        "max_pairs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "new_text_max_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "target_max_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_changed_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_changed_lines": {
          "type": "integer",
          "minimum": 6,
          "description": "The effective changed-line cap: max(6, ratio * lines of the target)."
        },
        "max_diff_lines": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "max_pairs",
        "new_text_max_bytes",
        "target_max_bytes",
        "max_changed_ratio",
        "max_changed_lines",
        "max_diff_lines"
      ],
      "additionalProperties": false
    },
    "context": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^context-[1-4](\\.[A-Za-z0-9]{1,16})?(?![\\s\\S])"
          },
          "sha256": {
            "$ref": "../defs.json#/$defs/sha256"
          }
        },
        "required": [
          "name",
          "sha256"
        ],
        "additionalProperties": false
      },
      "maxItems": 4
    }
  },
  "required": [
    "proposal_id",
    "run_token",
    "revision",
    "run",
    "target_name",
    "target_sha256",
    "target_class",
    "risk",
    "limits",
    "context"
  ],
  "additionalProperties": false
}
