{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "self-improve/cli/scan.json",
  "title": "scan output",
  "description": "Printed on exit 0. A disabled scan or nothing new is exit 22 with the error envelope.",
  "type": "object",
  "properties": {
    "retros": {
      "type": "integer",
      "minimum": 0
    },
    "drafted": {
      "type": "integer",
      "minimum": 0
    },
    "unresolved": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "skipped": {
      "type": "integer",
      "minimum": 0
    },
    "proposals": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/row"
      },
      "maxItems": 1000
    },
    "warnings": {
      "type": "array",
      "items": {
        "enum": [
          "already_running"
        ]
      },
      "maxItems": 2,
      "uniqueItems": true
    }
  },
  "required": [
    "retros",
    "drafted",
    "unresolved",
    "failed",
    "skipped",
    "proposals",
    "warnings"
  ],
  "additionalProperties": false
}
