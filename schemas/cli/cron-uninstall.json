{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "self-improve/cli/cron-uninstall.json",
  "title": "cron uninstall --dry-run output",
  "description": "block is the removed block text, empty when absent.",
  "type": "object",
  "properties": {
    "action": {
      "enum": [
        "removed",
        "absent"
      ]
    },
    "block": {
      "type": "string",
      "minLength": 0,
      "maxLength": 65536
    }
  },
  "required": [
    "action",
    "block"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "absent"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "block": {
            "maxLength": 0
          }
        }
      }
    }
  ]
}
