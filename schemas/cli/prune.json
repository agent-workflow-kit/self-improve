{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "self-improve/cli/prune.json",
  "title": "prune output",
  "description": "Counts per kind; with dry_run true, what would be removed.",
  "type": "object",
  "properties": {
    "dry_run": {
      "type": "boolean"
    },
    "removed": {
      "type": "object",
      "properties": {
        "proposals": {
          "type": "integer",
          "minimum": 0
        },
        "backups": {
          "type": "integer",
          "minimum": 0
        },
        "session_artifacts": {
          "type": "integer",
          "minimum": 0
        },
        "sessions": {
          "type": "integer",
          "minimum": 0
        },
        "temp_files": {
          "type": "integer",
          "minimum": 0
        },
        "scanned_retros": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "proposals",
        "backups",
        "session_artifacts",
        "sessions",
        "temp_files",
        "scanned_retros"
      ],
      "additionalProperties": false
    },
    "recoveries": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/proposal_id"
      },
      "maxItems": 1000,
      "uniqueItems": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "enum": [
          "already_running",
          "cleanup_incomplete"
        ]
      },
      "maxItems": 2,
      "uniqueItems": true
    }
  },
  "required": [
    "dry_run",
    "removed",
    "recoveries",
    "warnings"
  ],
  "additionalProperties": false
}
