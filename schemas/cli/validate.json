{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "self-improve/cli/validate.json",
  "title": "validate output",
  "description": "Printed with --json on exits 0, 2 and 12. Exit 0 ok (warnings allowed), 2 invalid config, 12 a failed check; probe_* checks only with --probe.",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/check"
      },
      "maxItems": 32
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
      },
      "maxItems": 32,
      "uniqueItems": true
    }
  },
  "required": [
    "ok",
    "checks",
    "warnings"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "ok": {
                  "const": true
                }
              }
            }
          }
        }
      }
    }
  ]
}
