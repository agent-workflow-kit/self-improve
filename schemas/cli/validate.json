{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "self-improve/cli/validate.json",
  "title": "validate output",
  "description": "Printed with --json on exits 0, 2 and 12 (always, whether or not it fails). Exit 0 ok (warnings allowed), 2 invalid config, 12 a failed check; on 2 or 12 an error object names the first failing check. launch_plan and retro_list checks only with --probe.",
  "type": "object",
  "properties": {
    "ok": {
      "type": "boolean"
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "../defs.json#/$defs/check"
      },
      "maxItems": 32
    },
    "warnings": {
      "type": "array",
      "items": {
        "enum": [
          "sandbox_lowered",
          "scan_line_without_enable",
          "env_file_unsafe",
          "recovery_pending",
          "weaker_apply_guarantee"
        ]
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "unicode_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[0-9]+(\\.[0-9]+){1,3}(?![\\s\\S])"
    },
    "pinned": {
      "type": "object",
      "properties": {
        "claude_session": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "session_audit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        }
      },
      "required": [
        "claude_session",
        "session_audit"
      ],
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "properties": {
        "code": {
          "enum": [
            "usage",
            "config_invalid",
            "failed"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "ok",
    "checks",
    "warnings",
    "unicode_version",
    "pinned"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "ok": {
            "const": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "then": {
        "properties": {
          "checks": {
            "items": {
              "properties": {
                "ok": {
                  "const": true
                }
              }
            }
          }
        },
        "not": {
          "required": [
            "error"
          ]
        }
      }
    }
  ]
}
