{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "self-improve/config.json",
  "title": "self-improve config",
  "description": "Merged config after config.yaml and config.d/*.yaml. Self-contained (no external $ref). Every key is optional and takes its default. Unknown keys are refused. Pattern validity of path globs, duration ranges and cross-key checks are made by the tool.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "duration": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[1-9][0-9]{0,8}[smhd](?![\\s\\S])",
      "description": "A duration such as 30s, 10m, 1h or 90d."
    },
    "hook_timeout": {
      "anyOf": [
        {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 600
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^(?!0+(\\.0+)?(ms|s|m)?(?![\\s\\S]))[0-9]{1,9}(\\.[0-9]+)?(ms|s|m)?(?![\\s\\S])"
        }
      ],
      "description": "Default 30 seconds, at most 600 s."
    },
    "target_class": {
      "enum": [
        "skill",
        "instructions_file",
        "config",
        "permission_profile",
        "workflow"
      ]
    }
  },
  "properties": {
    "me": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9._@-]{1,64}(?![\\s\\S])"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "draft": {
      "type": "object",
      "properties": {
        "skill": {
          "type": "string",
          "minLength": 3,
          "maxLength": 129,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}:[a-z0-9][a-z0-9-]{0,63}(?![\\s\\S])",
          "default": "self-improve:improve"
        },
        "skill_marker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "plugin_dirs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^/[^\\x00]{0,4095}(?![\\s\\S])"
          },
          "maxItems": 8,
          "default": []
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "timeout": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 1,
              "maximum": 7200
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^(?!0+(\\.0+)?(ms|s|m)?(?![\\s\\S]))(?:[0-9]{1,9}(\\.[0-9]+)?(s|m|h)?|[1-9][0-9]{3,8}ms)(?![\\s\\S])"
            }
          ],
          "description": "Session timeout, 1 s to 2 h (range checked by the tool for strings).",
          "default": "10m"
        },
        "max_turns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "default": 12
        },
        "permission_profile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(/|~/)[^\\x00]{0,4094}(?![\\s\\S])"
        },
        "sandbox": {
          "enum": [
            "required",
            "preferred",
            "off"
          ],
          "default": "required"
        },
        "setting_sources": {
          "type": "array",
          "items": {
            "enum": [
              "user",
              "project",
              "local"
            ]
          },
          "uniqueItems": true,
          "maxItems": 3,
          "default": []
        },
        "env_allowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}(?![\\s\\S])"
          },
          "maxItems": 64,
          "uniqueItems": true,
          "default": [
            "PATH",
            "HOME",
            "USER",
            "LANG",
            "TERM"
          ]
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}(?![\\s\\S])"
          },
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "default": [
            "Read",
            "Write",
            "Bash",
            "Skill"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "maxItems": 32,
            "uniqueItems": true
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(/|~/)[^\\x00]{0,4094}(?![\\s\\S])"
          },
          "class": {
            "$ref": "#/$defs/target_class"
          },
          "sensitive": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "path",
          "class"
        ],
        "additionalProperties": false,
        "description": "A file or, for class skill, a directory of skills."
      },
      "maxItems": 256,
      "default": []
    },
    "refuse_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "maxItems": 256,
      "default": [],
      "description": "Extra refused-tier patterns."
    },
    "sensitive_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "maxItems": 256,
      "default": [],
      "description": "Extra sensitive-tier patterns."
    },
    "ordinary_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024
      },
      "maxItems": 256,
      "default": [],
      "description": "Extra ordinary-tier patterns."
    },
    "limits": {
      "type": "object",
      "properties": {
        "drafts_per_day": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "default": 20
        },
        "revisions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 5
        },
        "target_max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216,
          "default": 262144
        },
        "new_text_max_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576,
          "default": 65536
        },
        "max_pairs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 20
        },
        "max_changed_ratio": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1,
          "default": 0.3
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "display": {
      "type": "object",
      "properties": {
        "max_lines": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000,
          "default": 2000
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "scan": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "max_per_run": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000,
          "default": 5
        },
        "risk": {
          "type": "array",
          "items": {
            "enum": [
              "high",
              "medium"
            ]
          },
          "uniqueItems": true,
          "maxItems": 2,
          "default": [
            "high",
            "medium"
          ]
        },
        "classes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/target_class"
          },
          "uniqueItems": true,
          "maxItems": 5,
          "default": [
            "skill",
            "instructions_file",
            "config",
            "permission_profile",
            "workflow"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "redaction": {
      "type": "object",
      "properties": {
        "mask_env": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,127}(?![\\s\\S])"
          },
          "maxItems": 64,
          "uniqueItems": true,
          "default": []
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "retention": {
      "type": "object",
      "properties": {
        "proposals": {
          "$ref": "#/$defs/duration",
          "default": "90d"
        },
        "backups": {
          "$ref": "#/$defs/duration",
          "default": "90d"
        },
        "scanned": {
          "$ref": "#/$defs/duration",
          "default": "180d"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "hooks": {
      "type": "object",
      "properties": {
        "pre-draft": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cmd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "Run via sh -c in its own process group."
              },
              "timeout": {
                "$ref": "#/$defs/hook_timeout"
              },
              "async": {
                "type": "boolean"
              }
            },
            "required": [
              "cmd"
            ],
            "additionalProperties": false
          },
          "maxItems": 32,
          "default": []
        },
        "pre-accept": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cmd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "Run via sh -c in its own process group."
              },
              "timeout": {
                "$ref": "#/$defs/hook_timeout"
              },
              "async": {
                "type": "boolean"
              }
            },
            "required": [
              "cmd"
            ],
            "additionalProperties": false
          },
          "maxItems": 32,
          "default": []
        },
        "post-accept": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cmd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "Run via sh -c in its own process group."
              },
              "timeout": {
                "$ref": "#/$defs/hook_timeout"
              },
              "async": {
                "type": "boolean"
              }
            },
            "required": [
              "cmd"
            ],
            "additionalProperties": false
          },
          "maxItems": 32,
          "default": []
        },
        "post-attention": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "cmd": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096,
                "description": "Run via sh -c in its own process group."
              },
              "timeout": {
                "$ref": "#/$defs/hook_timeout"
              },
              "async": {
                "type": "boolean"
              }
            },
            "required": [
              "cmd"
            ],
            "additionalProperties": false
          },
          "maxItems": 32,
          "default": []
        }
      },
      "required": [],
      "additionalProperties": false,
      "default": {}
    }
  }
}
