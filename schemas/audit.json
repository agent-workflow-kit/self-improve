{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "self-improve/audit.json",
  "title": "self-improve audit.jsonl record",
  "description": "One record per phase for every write to a user file: attempted before the write and the outcome after it. Refusals, vetoes, escalations and declined confirmations are not audited.",
  "type": "object",
  "properties": {
    "ts": {
      "$ref": "defs.json#/$defs/timestamp"
    },
    "actor": {
      "$ref": "defs.json#/$defs/actor"
    },
    "actor_source": {
      "$ref": "defs.json#/$defs/actor_source"
    },
    "stdin_tty": {
      "type": "boolean"
    },
    "decision_id": {
      "anyOf": [
        {
          "$ref": "defs.json#/$defs/decision_id"
        },
        {
          "type": "array",
          "items": {
            "$ref": "defs.json#/$defs/decision_id"
          },
          "maxItems": 16
        }
      ]
    },
    "attempt_id": {
      "$ref": "defs.json#/$defs/attempt_id",
      "description": "Shared by the attempted and outcome records."
    },
    "action": {
      "$ref": "defs.json#/$defs/action"
    },
    "target": {
      "$ref": "defs.json#/$defs/path"
    },
    "inputs": {
      "type": "object",
      "properties": {
        "proposal_id": {
          "$ref": "defs.json#/$defs/proposal_id"
        },
        "retro_id": {
          "$ref": "defs.json#/$defs/retro_id"
        },
        "candidate_id": {
          "$ref": "defs.json#/$defs/candidate_id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "plan_sha256": {
          "$ref": "defs.json#/$defs/sha256"
        },
        "tier": {
          "$ref": "defs.json#/$defs/plan_tier"
        },
        "pre_sha256": {
          "$ref": "defs.json#/$defs/sha256"
        },
        "post_sha256": {
          "$ref": "defs.json#/$defs/sha256"
        }
      },
      "required": [
        "proposal_id",
        "retro_id",
        "candidate_id",
        "revision",
        "plan_sha256",
        "tier",
        "pre_sha256",
        "post_sha256"
      ],
      "additionalProperties": false,
      "description": "Hashes and ids only, never text."
    },
    "result": {
      "$ref": "defs.json#/$defs/result"
    },
    "recovered": {
      "type": "boolean",
      "description": "True on an outcome record written by recovery."
    }
  },
  "required": [
    "ts",
    "actor",
    "actor_source",
    "stdin_tty",
    "attempt_id",
    "action",
    "target",
    "inputs",
    "result"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "accept"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "enum": [
              "attempted",
              "applied",
              "failed",
              "stale"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "undo"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "result": {
            "enum": [
              "attempted",
              "undone",
              "failed",
              "stale"
            ]
          }
        }
      }
    }
  ]
}
