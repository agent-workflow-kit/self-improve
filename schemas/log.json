{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "self-improve/log.json",
  "title": "self-improve log.jsonl record",
  "description": "Hash-only: never retro, model or file text. Refusals, dry runs and failed commands write nothing.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "ts": {
          "$ref": "defs.json#/$defs/timestamp"
        },
        "actor": {
          "$ref": "defs.json#/$defs/actor"
        },
        "action": {
          "const": "proposal_state"
        },
        "proposal_id": {
          "$ref": "defs.json#/$defs/proposal_id"
        },
        "state": {
          "$ref": "defs.json#/$defs/state"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "defs.json#/$defs/reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "retro_id": {
          "$ref": "defs.json#/$defs/retro_id"
        },
        "candidate_id": {
          "$ref": "defs.json#/$defs/candidate_id"
        },
        "revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "target_sha256": {
          "anyOf": [
            {
              "$ref": "defs.json#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "csession_id": {
          "anyOf": [
            {
              "$ref": "defs.json#/$defs/csession_id"
            },
            {
              "type": "null"
            }
          ]
        },
        "cost_usd": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "num_turns": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "decision_ids": {
          "type": "array",
          "items": {
            "$ref": "defs.json#/$defs/decision_id"
          },
          "maxItems": 16
        }
      },
      "required": [
        "ts",
        "action",
        "proposal_id",
        "state",
        "reason",
        "retro_id",
        "candidate_id",
        "revision",
        "target_sha256",
        "csession_id",
        "cost_usd",
        "num_turns",
        "decision_ids"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ts": {
          "$ref": "defs.json#/$defs/timestamp"
        },
        "actor": {
          "$ref": "defs.json#/$defs/actor"
        },
        "action": {
          "const": "scan"
        },
        "retros": {
          "type": "integer",
          "minimum": 0
        },
        "drafted": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved": {
          "type": "integer",
          "minimum": 0
        },
        "failed": {
          "type": "integer",
          "minimum": 0
        },
        "skipped": {
          "type": "integer",
          "minimum": 0
        },
        "filtered": {
          "type": "integer",
          "minimum": 0
        },
        "capped": {
          "type": "integer",
          "minimum": 0
        },
        "deferred": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "ts",
        "action",
        "retros",
        "drafted",
        "unresolved",
        "failed",
        "skipped",
        "filtered",
        "capped",
        "deferred"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ts": {
          "$ref": "defs.json#/$defs/timestamp"
        },
        "actor": {
          "$ref": "defs.json#/$defs/actor"
        },
        "action": {
          "const": "recovered"
        },
        "attempt_id": {
          "$ref": "defs.json#/$defs/attempt_id"
        },
        "proposal_id": {
          "$ref": "defs.json#/$defs/proposal_id"
        },
        "apply_action": {
          "$ref": "defs.json#/$defs/action"
        },
        "result": {
          "enum": [
            "applied",
            "undone",
            "failed",
            "stale"
          ]
        }
      },
      "required": [
        "ts",
        "action",
        "attempt_id",
        "proposal_id",
        "apply_action",
        "result"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ts": {
          "$ref": "defs.json#/$defs/timestamp"
        },
        "actor": {
          "$ref": "defs.json#/$defs/actor"
        },
        "action": {
          "const": "prune"
        },
        "removed": {
          "type": "object",
          "properties": {
            "proposals": {
              "type": "integer",
              "minimum": 0
            },
            "backups": {
              "type": "integer",
              "minimum": 0
            },
            "session_artifacts": {
              "type": "integer",
              "minimum": 0
            },
            "sessions": {
              "type": "integer",
              "minimum": 0
            },
            "temp_files": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "proposals",
            "backups",
            "session_artifacts",
            "sessions",
            "temp_files"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "ts",
        "action",
        "removed"
      ],
      "additionalProperties": false
    }
  ]
}
