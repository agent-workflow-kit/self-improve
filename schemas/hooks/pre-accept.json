{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "self-improve/hooks/pre-accept.json",
  "title": "pre-accept hook payload",
  "description": "Stdin JSON, after the confirmation and before the audit record and the write. Exit 0 continue; 13 hold; other non-zero veto.",
  "type": "object",
  "properties": {
    "tool": {
      "const": "self-improve"
    },
    "hook": {
      "const": "pre-accept"
    },
    "object_type": {
      "const": "proposal"
    },
    "object_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}(?![\\s\\S])"
    },
    "event_id": {
      "$ref": "../defs.json#/$defs/event_id"
    },
    "labels": {
      "$ref": "../defs.json#/$defs/labels"
    },
    "reads_third_party": {
      "const": false
    },
    "tainted": {
      "const": false
    },
    "proposal_id": {
      "$ref": "../defs.json#/$defs/proposal_id"
    },
    "action": {
      "$ref": "../defs.json#/$defs/action"
    },
    "target_path": {
      "$ref": "../defs.json#/$defs/path"
    },
    "tier": {
      "$ref": "../defs.json#/$defs/plan_tier"
    },
    "plan_sha256": {
      "$ref": "../defs.json#/$defs/sha256"
    }
  },
  "required": [
    "tool",
    "hook",
    "object_type",
    "object_id",
    "event_id",
    "labels",
    "reads_third_party",
    "tainted",
    "proposal_id",
    "action",
    "target_path",
    "tier",
    "plan_sha256"
  ],
  "additionalProperties": false
}
